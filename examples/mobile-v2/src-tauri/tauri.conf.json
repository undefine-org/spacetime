{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "examples/mobile-v2",
  "version": "0.1.0",
  "identifier": "com.spacetime.examples/mobile_v2",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "examples/mobile-v2",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "haptics": {},
    "biometric": {},
    "notification": {},
    "geolocation": {},
    "barcode-scanner": {}
  }
}
