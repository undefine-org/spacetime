(function() {
const el = document.body;
(function() {
    // Global data source - uses event dispatch instead of element-scoped yields
    const sourceName = "stats";
    const srcValue = "/data/stats.json";
    const defaultValue = null;
    const refreshInterval = 0;

    // Register in global data store
    const store = window.__spacetimeData[sourceName] = {
      data: null,
      loading: true,
      error: null
    };

    const dispatch = (type, detail) => {
      document.dispatchEvent(new CustomEvent(`data:${sourceName}:${type}`, { detail }));
    };

    const load = async () => {
      if (!srcValue) {
        store.loading = false;
        store.error = 'No source URL provided';
        dispatch('error', store.error);
        return;
      }
      store.loading = true;
      store.error = null;
      dispatch('loading', true);

      try {
        let result;

        if (srcValue.startsWith('localStorage:')) {
          // Load from localStorage
          const key = srcValue.slice('localStorage:'.length);
          const stored = localStorage.getItem(key);
          if (stored) {
            result = JSON.parse(stored);
          } else if (defaultValue !== undefined) {
            result = defaultValue;
          } else {
            result = null;
          }
        } else if (srcValue === 'inline') {
          // Inline data uses default value
          result = defaultValue;
        } else {
          // Fetch from URL (resolve {locale} placeholder if present)
          const resolvedLocale =
          window.__st_locale || document.documentElement.lang || 'en';

        if (srcValue.indexOf('{locale}') !== -1 && !resolvedLocale) {
            console.warn('[Spacetime] data-source "' + sourceName + '": URL contains {locale} but no locale could be resolved. Falling back to "en". Ensure @locale runs before @data.');
          }
          const fetchUrl = srcValue.replace('{locale}', resolvedLocale);
          const response = await fetch(fetchUrl);
          if (!response.ok) {
            throw new Error(response.statusText);
          }
          result = await response.json();
        }

        store.data = result;
        store.loading = false;
        dispatch('data', result);

        // Use registry for @data/@each coordination (handles 'loaded' event internally)
        ST.setData(sourceName, result);

        if (Array.isArray(result) && result.length === 0) {
          dispatch('empty');
        }
      } catch (err) {
        store.loading = false;
        store.error = err.message;
        dispatch('error', err.message);

        // Resolve the URL for error reporting (matches fetch logic)
        const resolvedUrl = srcValue.replace('{locale}', resolvedLocale || 'en');

        // Report to debugger if available (debug mode)
        if (window.__ST_DEBUG__ && window.__ST_DEBUG__.recordError) {
          window.__ST_DEBUG__.recordError('data-source', err, {
            name: sourceName,
            src: resolvedUrl
          });
        }

        // Always log a formatted bug report to console (for copy/paste)
        console.error(
          `%c[Spacetime Runtime Error]%c\n` +
          `Source: data-source\n` +
          `Name: ${sourceName}\n` +
          `URL: ${resolvedUrl}\n` +
          `Error: ${err.message}\n` +
          `\n--- Copy below for bug report ---\n` +
          JSON.stringify({
            type: 'runtime-error',
            source: 'data-source',
            name: sourceName,
            src: resolvedUrl,
            error: err.message,
            stack: err.stack,
            timestamp: new Date().toISOString(),
            url: window.location.href
          }, null, 2),
          'color: #ef4444; font-weight: bold;',
          'color: inherit;'
        );
      }
    };

    store.reload = load;

    // Initial load
    load();

    // Set up refresh interval if specified
    let intervalId = null;
    if (refreshInterval > 0) {
      intervalId = setInterval(load, refreshInterval);
    }

    // Global sources persist for page lifetime (no cleanup needed)
    })();;
})();
