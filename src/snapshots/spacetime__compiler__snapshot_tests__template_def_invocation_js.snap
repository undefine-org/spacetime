    for (var i = 0; i < doc.content.length; i++) {
      var innerSpan = blockSize(doc.content[i]) - 2; // addressable span inside the block
      var open = acc;            // position just inside this block's start
      var close = acc + innerSpan;
      if (p <= close + 1) {
