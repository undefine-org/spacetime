    var out = [];
    marks.forEach(function (m) {
      var key = m.type + ':' + JSON.stringify(m.attrs || null);
      if (!seen[key]) { seen[key] = 1; out.push({ type: m.type, attrs: m.attrs || undefined }); }
    });
    out.sort(function (a, b) { return a.type < b.type ? -1 : a.type > b.type ? 1 : 0; });
    return out;
