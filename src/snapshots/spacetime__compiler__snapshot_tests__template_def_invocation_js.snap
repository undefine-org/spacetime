 * ## Document shape
 *   doc   = { type: "doc", content: Block[] }
 *   Block = { type: <blockName>, attrs?, content: Inline[] }      e.g. p, h2, figure
 *   Inline= { type: "text", text: string, marks?: Mark[] }
