    // Returns the number of frames stepped.
    advance(ms) {
      if (!this.virtual) this.install();
      const target = this.now + Math.max(0, ms);
      let frames = 0;
      while (this.now < target) {
        this.now = Math.min(target, this.now + this.frameMs);
        ST._raf.tickAll(this.now);
