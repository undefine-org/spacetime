// This file demonstrates all type expression syntax for testing the Chumsky parser
// It showcases the type system used in @type, @data, @fn definitions

// =============================================================================
// Primitive Types
// =============================================================================

// Basic primitives
string
number
boolean
any

// Custom/reference types (type references)
Item
Product
User
CartItem

// =============================================================================
// Optional Types
// =============================================================================

// Optional primitives (nullable)
string?
number?
boolean?

// Optional references
Item?
Product?

// =============================================================================
// Array Types
// =============================================================================

// Array of primitives
string[]
number[]
boolean[]

// Array of references
Item[]
Product[]
User[]

// =============================================================================
// Optional Array Types
// =============================================================================

// Arrays that can be null
string[]?
number[]?
Item[]?
Product[]?

// =============================================================================
// Union Types (String Literals)
// =============================================================================

// Two-variant union
"active" | "inactive"
"S" | "M" | "L"

// Multi-variant union
"pending" | "processing" | "completed" | "failed"
"xs" | "sm" | "md" | "lg" | "xl"

// =============================================================================
// Object Types
// =============================================================================

// Simple object
{ name: string }

// Multi-field object
{ name: string, age: number }

// Object with optional field
{ name: string, nickname?: string }

// Complex object with various field types
{ id: number, name: string, active: boolean, tags: string[] }

// Object with reference types
{ product: Product, quantity: number }

// =============================================================================
// Function Types
// =============================================================================

// No params, void return
fn() -> void

// Single param
fn(x: number) -> number

// Multiple params
fn(a: string, b: number) -> boolean

// Complex params
fn(items: Item[]) -> Item[]

// Optional return
fn(id: string) -> Item?

// =============================================================================
// Nested/Complex Types
// =============================================================================

// Object with array field
{ items: Item[], count: number }

// Object with nested object
{ data: { nested: string, value: number } }

// Object with optional array field
{ tags?: string[], items: Product[] }

// =============================================================================
// Type Annotations (in context)
// =============================================================================

// Type annotation format: ": Type"
// Used in @fn params, @data definitions, @type fields
// name: string
// products: Product[]
// callback: fn(x: number) -> number
