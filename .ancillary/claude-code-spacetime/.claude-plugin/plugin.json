{
    "name": "claude-code-spacetime",
    "description": "Spacetime plugin for Claude",
    "version": "0.1.0",
    "author": {
        "name": "Othman Benkiran"
    },
    "lspServers": {
        "spacetime": {
            "command": "cargo",
            "args": [
                "run",
                "--manifest-path",
                "/home/user/code/ora/spacetime-testing/Cargo.toml",
                "--release",
                "--",
                "lsp"
            ],
            "extensionToLanguage": {
                ".st": "spacetime"
            },
            "transport": "stdio",
            "initializationOptions": {},
            "settings": {},
            "maxRestarts": 3
        }
    }
}
